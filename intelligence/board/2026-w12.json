 "waiver_targets": [
  {
   "name": "Ted Hurst III",
   "position": "WR",
   "nfl_team": "TB",
   "proj": 5.82,
   "ros_rank": 121.0,
   "fp_waiver_rank": 6.0,
   "injury": "ACTIVE",
   "replaces": "Ryan Flournoy",
   "ros_rank_gain": -46.0,
   "week_proj_gain": -7.65,
   "priority": "MEDIUM",
   "availability": "ESPN_WAIVERS",
   "espn_pct_owned": 1.8,
   "fp_waiver_note": "Third-round rookie Ted Hurst played his best game of the season for the Buccaneers on Sunday, finishing with 5-56-2 on seven targets. Hurst reliably got himself open and made some terrific plays on the ball. Hurst was third in snaps and routes among the Tampa Bay receivers in Week 11, but not that far behind Emeka Egbuka. Chris Godwin led the Buccaneers' receivers in both categories. A big-play receiver with a 6-foot-3 frame and 4.42 speed, Hurst could surge down the stretch. It's also possible he could be thwarted by the limitations of QB Baker Mayfield and the Buccaneers' passing game. Hurst is an intriguing speculative addition."
  },
  {
   "name": "Tyler Higbee",
   "position": "TE",
   "nfl_team": "LAR",
   "proj": 7.7,
   "ros_rank": 132.0,
   "fp_waiver_rank": 7.0,
   "injury": "ACTIVE",
   "replaces": "Pat Freiermuth",
   "ros_rank_gain": -8.0,
   "week_proj_gain": -1.87,
   "priority": "MEDIUM",
   "availability": "ESPN_WAIVERS",
   "espn_pct_owned": 7.1,
   "fp_waiver_note": "With WR Puka Nacua on injured reserve and WR Davante Adams not expected back from his hamstring injury, someone has to catch passes for the Rams in their Wednesday-night game against the Packers. Rams head coach Sean McVay has leaned heavily into multiple-TE use, and with Terrance Ferguson on injured reserve, veteran Tyler Higbee is the Rams' top pass-catching tight end. With Nacua and Adams out in Week 10, Higbee led the Rams' tight ends with four targets and had three catches for 17 yards and a touchdown. For the season, Higbee has 31-304-2 on 43 targets. The Packers have been stingy against TEs this season, allowing 8.0 half-point PPR fantasy points per game to the position. But the paucity of pass-catching options for Rams QB Matthew Stafford should keep Higbee involved this week and in the weeks to come."
  },
  {
   "name": "Darren Waller",
   "position": "TE",
   "nfl_team": "CAR",
   "proj": 7.32,
   "ros_rank": 128.0,
   "fp_waiver_rank": 10.0,
   "injury": "ACTIVE",
   "replaces": "Pat Freiermuth",
   "ros_rank_gain": -4.0,
   "week_proj_gain": -2.25,
   "priority": "MEDIUM",
   "availability": "ESPN_WAIVERS",
   "espn_pct_owned": 27.8,
   "fp_waiver_note": "Darren Waller is an unpredictable and TD-centric performer who's had games of 19.0, 16.8 and 11.5 half-point PPR fantasy points this season but has also produced 5.1 or fewer fantasy points in five games. The net result is that Waller is tied with Tucker Kraft for TE14 in half-point PPR fantasy points per game. Waller gets a Week 12 matchup against the Buccaneers, who entered Week 11 having allowed the eighth-most fantasy points per game to tight ends despite having a top defense. When Waller faced the Buccaneers in Week 7, he had only one catch, but it went for a 50-yard touchdown. You could conceivably stream Waller this week against the Bucs, but he won't be in play in Week 13 against a Vikings defense that stifles tight ends."
  },
